#!/bin/bash
# Что делается ДО того, как файлы лягут на диск.
#
# Одно, но существенное: остановить агента. Установщик кладёт новый питон и
# нового агента поверх старых, и делать это под работающим процессом нельзя.
#
# Мгновенно оно не рушится — процесс держит открытые файлы по inode, даже когда
# имена уже указывают на новые, — и потому выглядит работающим. Но любой
# отложенный импорт после подмены берёт уже НОВЫЙ файл рядом со старым, и в
# одном процессе оказываются две версии агента. Ломается это позже, в другом
# месте и без всякой связи с установкой.
#
# Задачи при этом теряются, и это осознанно: узел на время обновления выходит
# из строя, а оркестратор переносит работу. Плавная замена — дело обновлений по
# сети, где агент сливает задачи сам (looma_agent/update.py).

set -euo pipefail

PLIST="/Library/LaunchDaemons/app.looma.agent.plist"

# `|| true` на каждом шаге: при ПЕРВОЙ установке останавливать нечего, и
# ошибка здесь означала бы, что установщик падает на чистой машине.
if [ -f "$PLIST" ]; then
    launchctl bootout system "$PLIST" 2>/dev/null || true
    # Дать процессу закончиться: bootout возвращается сразу, а SIGTERM ещё
    # только в пути. Если не дождаться, распаковка начнётся ровно в тот момент,
    # ради которого всё это и написано.
    for _ in $(seq 1 20); do
        pgrep -f "looma_launcher.main" >/dev/null 2>&1 || break
        sleep 0.5
    done
fi

exit 0
