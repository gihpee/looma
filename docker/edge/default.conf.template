# Пограничный слой: единственное, что смотрит в интернет.
#
# Четыре имени на одном сертификате и одном IP:
#
#   ${LOOMA_DOMAIN}            лендинг
#   console.${LOOMA_DOMAIN}    клиентская платформа
#   admin.${LOOMA_DOMAIN}      панель администратора
#   api.${LOOMA_DOMAIN}        программный API — напрямую в оркестратор,
#                              без статики и без второго прокси
#
# Первые три идут в контейнер web, который сам решает по Host, какую сборку
# отдать и какие пути проксировать в оркестратор. Браузер всегда ходит на свой
# origin, поэтому CORS нигде не нужен.
#
# Порты 80 и 443 — хостовые: сеть у compose host, иначе p2p-порт rendezvous
# оказался бы за трансляцией и ни один узел не смог бы к нему подключиться.

# ---------------------------------------------------------------- http → https
server {
    listen 80;
    listen [::]:80;
    server_name ${LOOMA_DOMAIN}
                console.${LOOMA_DOMAIN}
                admin.${LOOMA_DOMAIN}
                api.${LOOMA_DOMAIN};

    # Проверка владения доменом ходит только сюда и только по http: заворачивать
    # её в https нельзя, потому что сертификата ещё нет — именно за ним и
    # пришли. Один webroot на все четыре имени: certbot кладёт токен в одну
    # папку, а Let's Encrypt спрашивает каждое имя по очереди.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------- лендинг, консоль, админка
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${LOOMA_DOMAIN}
                console.${LOOMA_DOMAIN}
                admin.${LOOMA_DOMAIN};

    # ssl_certificate и остальное — в ssl.conf (уровень http, общий для всех).

    # Полгода, потому что вернуться на http мы не собираемся. Ставится после
    # того, как сертификат уже работает: включённый заранее HSTS запирает домен
    # для всех, кто успел его увидеть, даже если выпуск не удался.
    add_header Strict-Transport-Security "max-age=15768000" always;

    # Ответ модели и результат задачи бывают большими, а установка окружения —
    # долгой. Здесь только предел на всякий случай: настоящие таймауты стоят у
    # web-nginx, который и знает, чего ждёт.
    client_max_body_size 512m;

    location / {
        proxy_pass http://127.0.0.1:${LOOMA_WEB_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # По этому заголовку оркестратор решает, ставить ли cookie с Secure.
        # Web-nginx его не трогает и пропускает дальше как есть.
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

# ------------------------------------------------------------------ api.
# Программные клиенты: OpenAI SDK на /v1, looma-connect на /connect, скрипты
# с админ-токеном на /admin. Статики здесь нет, поэтому и web-контейнер не
# нужен — сразу в оркестратор.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${LOOMA_DOMAIN};

    add_header Strict-Transport-Security "max-age=15768000" always;
    client_max_body_size 512m;

    location / {
        proxy_pass http://127.0.0.1:${LOOMA_HTTP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Канал до Ray-кластера — WebSocket, и он подолгу молчит: между двумя
        # вызовами из ноутбука может пройти час.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Без этого стрим токенов превращается в паузу на всю генерацию, а
        # потом весь текст разом.
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
