{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@looma/ui": ["./packages/ui/src/index.ts"],
      "@looma/ui/*": ["./packages/ui/src/*"],
      "@looma/api": ["./packages/api/src/index.ts"]
    }
  }
}
